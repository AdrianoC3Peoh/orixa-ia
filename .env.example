# ── Segurança ─────────────────────────────────────────────────────────────────
SECRET_KEY=troque-por-uma-string-aleatoria-longa-e-segura

# ── Anthropic (chat com IA) ───────────────────────────────────────────────────
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Crie em: https://console.cloud.google.com/ → APIs & Services → Credentials
# Tipo: OAuth 2.0 Client ID → Web application
# Authorized redirect URIs: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Deixe vazio para detecção automática (recomendado para ngrok/Railway)
GOOGLE_REDIRECT_URI=

# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./orixa.db

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Orixá IA
PREMIUM_PRICE=29.90
CODIGO_CONVITE=ORIXA2024
